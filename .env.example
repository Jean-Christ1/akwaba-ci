# Configuration Akwaba CI
#
# Copier ce fichier vers .env puis renseigner les valeurs du projet Supabase.
# Le fichier .env n'est jamais versionné.
#
# ATTENTION : toute variable préfixée VITE_ est inscrite dans le bundle envoyé
# au navigateur. N'y placez jamais un secret serveur. La clé service_role, le
# jeton Resend et BOOTSTRAP_ADMIN_TOKEN se configurent exclusivement dans les
# secrets Supabase, où seules les fonctions edge les lisent.

# URL du projet Supabase
VITE_SUPABASE_URL="https://votre-projet.supabase.co"

# Identifiant du projet Supabase
VITE_SUPABASE_PROJECT_ID="votre-projet"

# Clé publishable (anon). Publique par conception : l'accès aux données est
# gouverné par les politiques RLS, pas par le secret de cette clé.
VITE_SUPABASE_PUBLISHABLE_KEY="votre-cle-anon"
